# ─────────────────────────────────────────────────────────────────────────────
# 원비관리(tuition-manager) 환경변수 예시
#
# 사용법: 이 파일을 `.env.local` 로 복사하고 값을 채운다.
#   cp .env.example .env.local
#
# 🔴 `.env.local` 은 절대 커밋하지 마라 (.gitignore 에 이미 들어 있다).
# 🔴 `NEXT_PUBLIC_` 접두사가 붙은 값은 **브라우저 번들에 그대로 실린다.**
#    학부모에게 어차피 보이는 값(학원 이름·대표번호)만 여기 둔다. 비밀값은 절대 금지.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ 1. 필수 — 이게 없으면 앱이 뜨지 않는다 ═══════════════════════════════════

# Supabase 프로젝트 URL. 대시보드 → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service_role 키. 대시보드 → Project Settings → API Keys → service_role
#
# 🔴 이 키는 RLS 를 통째로 우회한다 = DB 전권이다.
#    이 앱은 **서버(API 라우트)에서만** 이 키를 쓴다(src/lib/supabase.ts).
#    절대 NEXT_PUBLIC_ 로 만들지 마라 — 브라우저에 실리는 순간 학생 개인정보와
#    결제 데이터 전체가 공개된다.
SUPABASE_SERVICE_ROLE_KEY=

# 관리자 로그인 계정 (이 앱은 관리자 단일 계정이다 — 다중 사용자 개념이 없다)
ADMIN_ID=admin
ADMIN_PASSWORD=

# 세션 쿠키 HMAC 서명 키. **최소 16자**, 길수록 좋다.
#   생성: openssl rand -base64 48
# 이 값을 바꾸면 발급된 모든 세션이 즉시 무효가 된다(= 강제 로그아웃 스위치이기도 하다).
SESSION_SECRET=

# 서버 타임존. 이 앱은 날짜 경계(청구 월·결제일·출결일)가 곧 돈이라 KST 고정이 전제다.
# 다른 나라에서 쓴다면 이 값과 함께 src/lib/date.ts 의 가정을 같이 검토해야 한다.
TZ=Asia/Seoul


# ═══ 2. 학원 브랜딩 — 화면·문자·청구서에 그대로 노출된다 ═══════════════════════
# (src/lib/branding.ts 가 이 값들을 읽는다. 미설정 시 "우리학원" 같은 기본값이 쓰인다.)

NEXT_PUBLIC_ACADEMY_NAME=우리학원
NEXT_PUBLIC_ACADEMY_SHORT_NAME=우리학원

# 키오스크 하단 한 줄 슬로건. 비워두면 그 줄이 안 나온다.
NEXT_PUBLIC_ACADEMY_TAGLINE=

# 청구서 발행 주체(사업자명). 결제 대행사 청구서에 표기된다.
ACADEMY_LEGAL_NAME=주식회사 우리교육

# 청구 메시지 하단 안내. 비워두면 해당 줄이 통째로 빠진다.
NEXT_PUBLIC_ACADEMY_PHONE=
NEXT_PUBLIC_ACADEMY_HOMEPAGE=

# 문자 발신번호(화면 안내 문구용 표시값). 실제 발신은 문자 대행사 등록번호로 나간다.
NEXT_PUBLIC_SMS_SENDER_NUMBER=


# ═══ 3. 결제선생(PaySsam) — 청구서 발송/결제 ══════════════════════════════════
#
# 결제선생은 한국의 학원 청구서 결제 서비스다(페이민트 운영).
# 파트너 API 키는 영업 계약 후 발급된다 — 개인이 즉시 발급받을 수 있는 종류가 아니다.
#
# 💡 이 블록을 통째로 비워두면 결제 기능만 동작하지 않는다.
#    학생·반·납부기록·출결 등 나머지 기능은 그대로 쓸 수 있다.
#    다른 결제 대행사를 쓰려면 `src/lib/payssam.ts` 하나만 갈아끼우면 된다
#    (호출부는 전부 그 모듈을 통한다).
#
# 🔴 여기엔 기본값(폴백)이 없다. 미설정이면 발송 시점에 명시적으로 실패한다 —
#    돈이 걸린 경로에서 "조용히 엉뚱한 곳으로 발사"보다 시끄러운 실패가 항상 낫다.

PAYSSAM_API_URL=
PAYSSAM_API_KEY=
PAYSSAM_MEMBER=
PAYSSAM_MERCHANT=

# 결제 결과 수신 URL. 이게 틀리면 청구서는 나가는데 '결제완료'가 앱에 영영 안 뜬다.
PAYSSAM_CALLBACK_URL=https://your-domain.example.com/api/payssam/callback

# 청구서 ID 접두사(영문 대문자 2~4자). 대행사 콘솔에서 우리 청구서를 눈으로 구분하는 용도.
PAYSSAM_BILL_PREFIX=TM


# ═══ 4. 문자·알림톡 (Solapi) — 선택 ═══════════════════════════════════════════
#
# 등·하원 알림톡, 미납 안내 문자에 쓴다. 비워두면 해당 발송만 동작하지 않는다.
# https://solapi.com — 발신번호 사전등록과 카카오 알림톡 템플릿 심사가 필요하다.

SOLAPI_API_KEY=
SOLAPI_API_SECRET=

# 사전 등록된 발신번호 (하이픈 있어도 됨 — 코드가 제거한다)
SOLAPI_FROM=

# 카카오 비즈니스 채널 pfId
SOLAPI_PFID=

# 심사 통과한 알림톡 템플릿 ID. 미설정이면 알림톡 대신 문자로 폴백한다.
SOLAPI_TEMPLATE_CHECKIN=
SOLAPI_TEMPLATE_CHECKOUT=


# ═══ 5. AI 에이전트 (Google Gemini) — 선택 ════════════════════════════════════
#
# 자연어로 명단을 필터링하고("이번달 미납인 고2 학생") 질문에 답하는 기능에 쓴다.
# https://aistudio.google.com/apikey 에서 발급.
# 비워두면 AI 기능만 500 을 돌려주고 나머지는 정상 동작한다.

GEMINI_API_KEY=

# 프록시를 경유해야 하는 환경에서만 설정. 보통은 비워둔다.
GEMINI_BASE_URL=


# ═══ 6. 원장 전용 재무 화면 PIN — 선택 ════════════════════════════════════════
#
# /finance (매출·지출·강사 급여)에 들어가는 2차 관문.
# 관리자 로그인을 **통과한 뒤에** 한 번 더 묻는다.
# 미설정이면 PIN 검증 API가 500 을 돌려주므로 재무 화면에 **아무도 들어갈 수 없다**(fail-closed).
# 재무 기능을 쓸 거라면 반드시 채워라.
FINANCE_PIN=


# ═══ 7. 예약 발송 크론 — 선택 ═════════════════════════════════════════════════
#
# 영업시간 외에 예약된 청구서를 실제로 내보내는 크론 라우트(/api/cron/*)의 인증 키.
#   생성: openssl rand -hex 32
# 호출: curl -H "Authorization: Bearer $CRON_SECRET" https://your-domain/api/cron/send-queued
#
# 🔴 이걸 비워두면 크론 라우트는 **항상 401** 을 준다(fail-closed, 의도된 설계).
#    예약 발송을 쓸 거라면 반드시 채워라 — 안 채우면 예약분이 영영 안 나간다.
CRON_SECRET=


# ═══ 8. 에러 추적 (Sentry) — 선택 ═════════════════════════════════════════════
#
# 셋 다 비워두면 Sentry 래핑 자체를 건너뛴다(next.config.ts). 계정 없이도 빌드된다.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
